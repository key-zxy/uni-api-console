# Copy to .env for a local container host and replace placeholders locally.
# Never commit .env or share secrets.
AUDIT_ADMIN_TOKEN=GENERATE_A_RANDOM_LOCAL_TOKEN
AUDIT_MANAGEMENT_KEY=
AUDIT_RETENTION_DAYS=7
# Bind the published admin UI to the local host only by default.
AUDIT_BIND_ADDRESS=127.0.0.1
AUDIT_PORT_PUBLISHED=8787
# Optional override for the native uni-api image/tag.
# UNI_API_IMAGE=yym68686/uni-api:0.1.152
